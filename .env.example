# Copy to .env.local and fill in. Placeholder values only: never commit real keys.

# Clerk (https://dashboard.clerk.com): API keys and the webhook signing secret for /api/webhooks/clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

# Postgres (Neon). DATABASE_URL: pooled connection (the Neon integration sets it on Vercel).
# Optional: the dedicated runtime login (README, Database roles). Falls back to DATABASE_URL.
DATABASE_URL_RUNTIME=postgresql://rge_runtime:password@host-pooler.example/rge?sslmode=require
DATABASE_URL=postgresql://rge_owner:password@host-pooler.example/rge?sslmode=require
# Migrations only (drizzle-kit): direct connection as the database owner.
DATABASE_URL_UNPOOLED=postgresql://rge_owner:password@host.example/rge?sslmode=require

# Vercel Blob, for uploaded resumes and consent proofs.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# Anthropic, for profile extraction and Find more.
ANTHROPIC_API_KEY=sk-ant-placeholder

# Signs extraction and Find more review drafts. Any long random string, for example: openssl rand -hex 32
RGE_DRAFT_SECRET=replace-with-a-long-random-string

# Optional, Playwright only: run the signed-in layout checks (tests/e2e/pages-fit.spec.ts).
# E2E_CLERK_TESTING=1
# E2E_MPC_ID=00000000-0000-0000-0000-000000000000
